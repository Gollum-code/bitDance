# trader 服务（vn.py 回测引擎 + 免费行情源）
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# 先装依赖再拷代码，利用 Docker 层缓存
COPY trader/requirements.txt /app/trader/requirements.txt
RUN pip install --upgrade pip && pip install -r /app/trader/requirements.txt

COPY trader /app/trader

WORKDIR /app/trader
EXPOSE 8000

CMD ["python", "main.py"]
